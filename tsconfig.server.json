{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "noUncheckedIndexedAccess": true,
    "rootDir": "src", "outDir": "dist", "types": ["node"],
    "rewriteRelativeImportExtensions": true, "verbatimModuleSyntax": true
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["src/server/**/*.test.ts", "src/server/fixtures.ts"]
}
