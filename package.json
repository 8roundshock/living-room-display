{
  "name": "living-room-display",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch src/server/index.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run typecheck && npm run build:server && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --test src/server/*.test.ts",
    "start": "node dist/server/index.js"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1", "zod": "4.6.7" },
  "devDependencies": {
    "@types/node": "^24.0.0", "@types/react": "19.3.0", "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2", "typescript": "7.0.2", "vite": "8.3.4"
  }
}
